#!/usr/bin/python3
"""Generate systemd-boot entries for recent compatible Snapper snapshots."""

import argparse
import fcntl
import os
import re
import subprocess
import sys
import tempfile
import xml.etree.ElementTree as ET
from datetime import datetime, timezone
from pathlib import Path


BOOT = Path("/boot")
ENTRIES = BOOT / "loader/entries"
SNAPSHOTS = Path("/.snapshots")
ROOT_SUBVOL = "/@"
ROOT_FLAGS = {"rootflags=subvol=/@", "rootflags=subvol=@"}
MARKER = "# Generated by systemd-boot-snapper\n"
ENTRY_PREFIX = "snapper-auto-"
LIMIT = 6


def run(*args):
    return subprocess.run(args, check=True, capture_output=True, text=True).stdout.strip()


def kernel_version(path):
    match = re.search(r"\bbzImage, version (\S+)", run("/usr/bin/file", "-b", str(path)))
    return match[1] if match else None


def load_kernel(path, root_uuid):
    lines = [line.strip() for line in path.read_text().splitlines()]
    fields = {}
    for line in lines:
        words = line.split(maxsplit=1)
        if len(words) == 2 and not line.startswith("#"):
            fields.setdefault(words[0], []).append(words[1])
    if any(len(fields.get(key, [])) != 1 for key in ("title", "options", "linux")) or not fields.get("initrd"):
        return None
    args = fields["options"][0].split()
    root_flags = [arg for arg in args if arg.startswith("rootflags=")]
    kernel_name = Path(fields["linux"][0]).name
    if (
        [arg.lower() for arg in args if arg.startswith("root=")] != [f"root=uuid={root_uuid.lower()}"]
        or len(root_flags) != 1
        or root_flags[0] not in ROOT_FLAGS
        or args.count("rw") != 1
        or "ro" in args
        or any(arg.startswith("systemd.volatile=") for arg in args)
        or kernel_name.endswith("-eac")
        or "efi" in fields
        or "uki" in fields
    ):
        return None
    images = []
    for name in fields["linux"] + fields["initrd"]:
        relative = Path(name.lstrip("/"))
        if not relative.parts or ".." in relative.parts:
            return None
        image = BOOT / relative
        if not image.is_file() or image.stat().st_size == 0:
            return None
        images.append(image)
    version = kernel_version(images[0])
    if version is None:
        return None
    flavor = f"{kernel_name} {fields['title'][0]}".lower()
    lts = bool(re.search(r"\blts\b", flavor))
    return lts, version, lines


def title_for(info, lts):
    date = datetime.fromisoformat(info.findtext("date"))
    if date.tzinfo is None:
        date = date.replace(tzinfo=timezone.utc)
    date_text = date.astimezone().strftime("%Y-%m-%d %H:%M:%S")
    kind = info.findtext("type")
    description = " ".join(info.findtext("description", "").split())
    prefix = {"pre": "Before ", "post": "After "}.get(kind, "")
    label = prefix + (description or ("package change" if prefix else "System snapshot"))
    suffix = " (LTS)" if lts else ""
    return f"Snapshot {date_text} - {label}{suffix}"


def render(lines, number, title):
    result = []
    for line in lines:
        key = line.split(maxsplit=1)[0] if line else ""
        if key == "title":
            line = f"title {title}"
        elif key == "options":
            line = re.sub(r"(?<!\S)rw(?=\s|$)", "ro", line, count=1)
            line = re.sub(
                r"(?<!\S)rootflags=subvol=/?@(?=\s|$)",
                f"rootflags=subvol={ROOT_SUBVOL}/.snapshots/{number}/snapshot",
                line,
                count=1,
            )
            line += " systemd.volatile=overlay"
        result.append(line)
    return MARKER + "\n".join(result) + "\n"


def desired_entries(root_uuid):
    kernels = []
    for path in sorted(ENTRIES.glob("*.conf")):
        kernel = load_kernel(path, root_uuid)
        if kernel is not None:
            kernels.append(kernel)
    kernels.sort(key=lambda kernel: kernel[0])
    candidates = sorted(
        (path for path in SNAPSHOTS.iterdir() if re.fullmatch(r"[1-9][0-9]*", path.name)),
        key=lambda path: int(path.name),
        reverse=True,
    )
    entries = {}
    for path in candidates:
        snapshot = path / "snapshot"
        for lts, version, lines in kernels:
            if not (snapshot / "usr/lib/modules" / version / "modules.dep").is_file():
                continue
            try:
                info = ET.parse(path / "info.xml").getroot()
                readonly = run("/usr/bin/btrfs", "property", "get", "-t", "subvol", str(snapshot), "ro")
            except FileNotFoundError:
                break
            except subprocess.CalledProcessError:
                if not snapshot.exists():
                    break
                raise
            if readonly != "ro=true":
                break
            if info.findtext("num") != path.name:
                raise ValueError(f"Snapshot number mismatch in {path}/info.xml")
            title = title_for(info, lts)
            entries[f"{ENTRY_PREFIX}{path.name}.conf"] = (title, render(lines, path.name, title))
            break
        if len(entries) == LIMIT:
            break
    return entries


def apply(entries):
    existing = {}
    for path in ENTRIES.glob(f"{ENTRY_PREFIX}*.conf"):
        content = path.read_text()
        if content.startswith(MARKER):
            existing[path.name] = content
        elif path.name in entries:
            raise ValueError(f"Refusing to replace an unmanaged entry: {path}")
    changed = 0
    for name, (_, content) in entries.items():
        if existing.get(name) == content:
            continue
        with tempfile.NamedTemporaryFile(mode="w", dir=ENTRIES, prefix=".snapshot-", delete=False) as out:
            temp = Path(out.name)
            try:
                out.write(content)
                out.flush()
                os.fsync(out.fileno())
                temp.replace(ENTRIES / name)
                changed += 1
            finally:
                temp.unlink(missing_ok=True)
    obsolete = existing.keys() - entries.keys()
    for name in obsolete:
        (ENTRIES / name).unlink()
    if changed or obsolete:
        print(f"Updated {changed} snapshot entries, removed {len(obsolete)}")


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--apply", action="store_true", help="write the generated entries to the EFI partition")
    args = parser.parse_args()
    root = run("/usr/bin/findmnt", "-nro", "FSTYPE,FSROOT,UUID", "-M", "/").split()
    if len(root) != 3 or root[:2] != ["btrfs", ROOT_SUBVOL]:
        print("Skipping snapshot menu refresh outside the live Btrfs @ root.")
        return
    root_uuid = root[2]
    if run("/usr/bin/findmnt", "-nro", "TARGET", "-T", str(SNAPSHOTS)) != "/":
        raise ValueError(f"Expected {SNAPSHOTS} on the root subvolume")
    if (
        run("/usr/bin/bootctl", "--print-esp-path") != str(BOOT)
        or run("/usr/bin/findmnt", "-nro", "FSTYPE", "-M", str(BOOT)) != "vfat"
    ):
        raise ValueError(f"Expected a FAT EFI System Partition mounted at {BOOT}")
    with open("/run/lock/systemd-boot-snapper.lock", "a") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        entries = desired_entries(root_uuid)
        if args.apply:
            apply(entries)
        else:
            print(f"{len(entries)} compatible root snapshots")
            for name, (title, _) in entries.items():
                print(f"{name}  {title}")


if __name__ == "__main__":
    try:
        main()
    except (OSError, ValueError, KeyError, TypeError, ET.ParseError, subprocess.CalledProcessError) as error:
        print(f"systemd-boot-snapper: {error}", file=sys.stderr)
        sys.exit(1)
